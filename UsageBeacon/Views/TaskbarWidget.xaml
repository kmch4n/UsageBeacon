<Window x:Class="UsageBeacon.Views.TaskbarWidget"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="UsageBeacon Widget"
        Width="118"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        AllowsTransparency="True"
        Background="Transparent"
        WindowStartupLocation="Manual">

    <!--
        The widget sits next to the taskbar at the same height.
        AllowsTransparency keeps the idle surface visually integrated with the taskbar.
    -->
    <Button x:Name="Root"
            Cursor="Hand"
            Background="Transparent"
            BorderThickness="0"
            Padding="0"
            Click="Root_Click">
        <Button.Template>
            <ControlTemplate TargetType="Button">
                <Grid>
                    <Border x:Name="BackgroundBorder"
                            Background="{TemplateBinding Background}"
                            CornerRadius="6">
                        <ContentPresenter/>
                    </Border>
                    <Border x:Name="FocusBorder"
                            BorderBrush="#FFFFFFFF"
                            BorderThickness="1"
                            CornerRadius="6"
                            Margin="1"
                            Visibility="Collapsed"
                            IsHitTestVisible="False"/>
                </Grid>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter TargetName="BackgroundBorder"
                                Property="Background"
                                Value="#26FFFFFF"/>
                    </Trigger>
                    <Trigger Property="IsPressed" Value="True">
                        <Setter TargetName="BackgroundBorder"
                                Property="Background"
                                Value="#40FFFFFF"/>
                    </Trigger>
                    <Trigger Property="IsKeyboardFocused" Value="True">
                        <Setter TargetName="FocusBorder"
                                Property="Visibility"
                                Value="Visible"/>
                    </Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate>
        </Button.Template>

        <Grid>
        <StackPanel x:Name="WideContent" Orientation="Horizontal"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center"
                    Margin="6,0">

            <!-- Claude -->
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="✦"
                           Foreground="#D07A42"
                           FontSize="13"
                           VerticalAlignment="Center"
                           Margin="0,0,4,0"/>
                <TextBlock x:Name="ClaudeLabel"
                           Text="--%"
                           Foreground="#F0F0F0"
                           FontSize="14"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"/>
            </StackPanel>

            <!-- Divider -->
            <Rectangle Width="1" Height="16"
                       Fill="#40FFFFFF"
                       Margin="6,0"/>

            <!-- Codex -->
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="▶"
                           Foreground="#7A8EE0"
                           FontSize="11"
                           VerticalAlignment="Center"
                           Margin="0,0,4,0"/>
                <TextBlock x:Name="CodexLabel"
                           Text="--%"
                           Foreground="#F0F0F0"
                           FontSize="14"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"/>
            </StackPanel>

        </StackPanel>

        <StackPanel x:Name="CompactContent"
                    Visibility="Collapsed"
                    Orientation="Horizontal"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center"
                    Margin="4,0">
            <TextBlock Text="✦" Foreground="#D07A42" FontSize="10" Margin="0,0,2,0"/>
            <TextBlock x:Name="CompactClaudeLabel"
                       Text="--" Foreground="#F0F0F0"
                       FontSize="12" FontWeight="SemiBold"/>
            <Rectangle Width="1" Height="14" Fill="#40FFFFFF" Margin="3,0"/>
            <TextBlock Text="▶" Foreground="#7A8EE0" FontSize="9" Margin="0,0,2,0"/>
            <TextBlock x:Name="CompactCodexLabel"
                       Text="--" Foreground="#F0F0F0"
                       FontSize="12" FontWeight="SemiBold"/>
        </StackPanel>

        <StackPanel x:Name="VerticalContent"
                    Visibility="Collapsed"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <TextBlock Text="&#x2726;" Foreground="#D07A42" FontSize="9" Margin="0,0,2,0"/>
                <TextBlock x:Name="VerticalClaudeLabel"
                           Text="--" Foreground="#F0F0F0"
                           FontSize="11" FontWeight="SemiBold"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <TextBlock Text="&#x25B6;" Foreground="#7A8EE0" FontSize="8" Margin="0,0,2,0"/>
                <TextBlock x:Name="VerticalCodexLabel"
                           Text="--" Foreground="#F0F0F0"
                           FontSize="11" FontWeight="SemiBold"/>
            </StackPanel>
        </StackPanel>

        </Grid>
    </Button>
</Window>
